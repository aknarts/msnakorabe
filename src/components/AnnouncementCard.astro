---
interface Props {
  title: string;
  date: Date;
  priority: 'normal' | 'high' | 'urgent';
}

const { title, date, priority } = Astro.props;

const priorityStyles = {
  urgent: 'border-l-red-500 bg-red-50',
  high: 'border-l-accent-400 bg-accent-50',
  normal: 'border-l-primary-400 bg-primary-50',
};

const badgeStyles = {
  urgent: 'bg-red-500 text-white',
  high: 'bg-accent-400 text-primary-800',
  normal: 'bg-primary-400 text-white',
};

const formattedDate = date.toLocaleDateString('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class:list={['border-l-4 rounded-r-xl p-5 shadow-sm', priorityStyles[priority]]}>
  <div class="flex items-start justify-between gap-3 mb-2">
    <h3 class="font-bold text-lg text-primary-700">{title}</h3>
    {priority !== 'normal' && (
      <span class:list={['text-xs font-semibold px-2 py-1 rounded-full shrink-0', badgeStyles[priority]]}>
        {priority === 'urgent' ? 'Důležité' : 'Aktualita'}
      </span>
    )}
  </div>
  <time class="text-sm text-gray-500 block mb-2" datetime={date.toISOString()}>
    {formattedDate}
  </time>
  <div class="text-gray-700 text-sm leading-relaxed prose prose-sm max-w-none">
    <slot />
  </div>
</article>
