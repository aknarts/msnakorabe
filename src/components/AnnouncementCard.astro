---
interface Props {
  title: string;
  date: Date;
  priority: 'normal' | 'high' | 'urgent';
  pinned?: boolean;
}

const { title, date, priority } = Astro.props;

const priorityStyles = {
  urgent: 'bg-red-50 ring-1 ring-red-200',
  high: 'bg-accent-50 ring-1 ring-accent-200',
  normal: 'bg-primary-50 ring-1 ring-primary-200',
};

const priorityLabel = {
  urgent: '🔴',
  high: '🟡',
  normal: '',
};

const formattedDate = date.toLocaleDateString('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class:list={['rounded-xl p-5 shadow-sm', priorityStyles[priority]]}>
  <div class="flex items-baseline gap-2 flex-wrap mb-2">
    {priorityLabel[priority] && <span class="text-sm" aria-hidden="true">{priorityLabel[priority]}</span>}
    <h3 class="font-bold text-lg text-primary-700">{title}</h3>
    <time class="text-xs text-gray-500 whitespace-nowrap" datetime={date.toISOString()}>
      {formattedDate}
    </time>
  </div>
  <div class="text-gray-700 text-sm leading-relaxed prose prose-sm max-w-none">
    <slot />
  </div>
</article>
