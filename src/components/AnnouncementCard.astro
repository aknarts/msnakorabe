---
interface Props {
  title: string;
  date: Date;
  priority: 'normal' | 'high' | 'urgent';
  pinned?: boolean;
}

const { title, date, priority } = Astro.props;

const priorityStyles = {
  urgent: 'border-l-red-500 bg-red-50',
  high: 'border-l-accent-400 bg-accent-50',
  normal: 'border-l-primary-400 bg-primary-50',
};

const formattedDate = date.toLocaleDateString('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class:list={['border-l-4 rounded-r-xl p-5 shadow-sm', priorityStyles[priority]]}>
  <div class="flex items-baseline gap-2 flex-wrap mb-2">
    <h3 class="font-bold text-lg text-primary-700">{title}</h3>
    <time class="text-xs text-gray-400 whitespace-nowrap" datetime={date.toISOString()}>
      {formattedDate}
    </time>
  </div>
  <div class="text-gray-700 text-sm leading-relaxed prose prose-sm max-w-none">
    <slot />
  </div>
</article>
