---
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details class="group border border-gray-200 rounded-xl overflow-hidden">
  <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer bg-gray-50 hover:bg-gray-100 transition-colors font-medium text-primary-700 list-none">
    <span>{question}</span>
    <svg class="w-5 h-5 shrink-0 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </summary>
  <div class="px-5 py-4 text-gray-700 text-sm leading-relaxed border-t border-gray-100">
    <slot />
  </div>
</details>
