---
import { url } from '../utils';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: url('/'), label: 'Domů' },
  { href: url('/o-nas'), label: 'O nás' },
  { href: url('/program'), label: 'Program' },
  { href: url('/tridy'), label: 'Třídy' },
  { href: url('/pro-rodice'), label: 'Pro rodiče' },
  { href: url('/odkazy'), label: 'Odkazy' },
  { href: url('/kontakt'), label: 'Kontakt' },
];

function isActive(href: string): boolean {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const normalizedPath = currentPath.replace(/\/$/, '') || '/';
  const normalizedHref = href.replace(/\/$/, '') || '/';
  if (normalizedHref === base || normalizedHref === '/') return normalizedPath === base || normalizedPath === '/' || normalizedPath === '';
  return normalizedPath.startsWith(normalizedHref);
}
---

<header class="bg-primary-700 text-white shadow-lg sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href={url('/')} class="flex items-center gap-2 sm:gap-3 shrink-0">
        <img src={url('/images/logo.png')} alt="MŠ Na Korábě" class="h-10 md:h-14 w-auto rounded-full bg-white/10 p-1" />
        <div>
          <div class="font-bold text-sm sm:text-lg leading-tight">MŠ Na Korábě</div>
          <div class="text-primary-200 text-xs hidden sm:block">Praha 8 – Libeň</div>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 rounded-lg text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-white/20 text-white'
                : 'text-primary-100 hover:bg-white/10 hover:text-white'
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Mobile hamburger -->
      <label for="mobile-menu-toggle" class="md:hidden cursor-pointer p-2 rounded-lg hover:bg-white/10">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
    </div>
  </div>

  <!-- Mobile menu (CSS-only toggle) -->
  <input type="checkbox" id="mobile-menu-toggle" class="hidden peer" />
  <nav class="md:hidden hidden peer-checked:block bg-primary-800 border-t border-primary-600">
    <div class="px-4 py-3 space-y-1">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={[
            'block px-3 py-2 rounded-lg text-sm font-medium transition-colors',
            isActive(item.href)
              ? 'bg-white/20 text-white'
              : 'text-primary-100 hover:bg-white/10 hover:text-white'
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
