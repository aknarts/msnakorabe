---
interface Props {
  title: string;
  description: string;
  image?: string;
  icon?: string;
}

const { title, description, image, icon } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow overflow-hidden flex flex-col">
  {image && (
    <div class="h-48 overflow-hidden">
      <img src={image} alt={title} class="w-full h-full object-cover" loading="lazy" />
    </div>
  )}
  <div class="p-6 flex-1 flex flex-col">
    {icon && !image && <div class="text-4xl mb-3">{icon}</div>}
    <h3 class="font-bold text-primary-700 mb-2">{title}</h3>
    <p class="text-gray-600 text-sm leading-relaxed flex-1">{description}</p>
  </div>
</div>
