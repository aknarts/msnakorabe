---
/**
 * Decorative floating boats that sail across the viewport.
 * 5 small ships at random vertical positions, each sailing
 * left-to-right or right-to-left at different speeds.
 * Similar pattern to FloatingSuns but with horizontal animation.
 */

const rand = (min: number, max: number) => Math.floor(Math.random() * (max - min + 1)) + min;
const coin = () => Math.random() > 0.5;

const COUNT = 5;
const MIN_DISTANCE = 15; // minimum vertical gap (%)
const placed: number[] = [];

function tooClose(top: number): boolean {
  return placed.some(p => Math.abs(p - top) < MIN_DISTANCE);
}

interface BoatItem {
  top: string;
  size: number;
  opacity: string;
  duration: number;
  delay: number;
  goRight: boolean;
  bobDuration: number;
}

const boats: BoatItem[] = [];

for (let i = 0; i < COUNT; i++) {
  let top = rand(8, 88);
  let attempts = 0;
  while (tooClose(top) && attempts < 30) {
    top = rand(8, 88);
    attempts++;
  }
  placed.push(top);

  const goRight = coin();
  const size = rand(40, 70);

  boats.push({
    top: `${top}%`,
    size,
    opacity: (rand(10, 25) / 100).toFixed(2),
    duration: rand(50, 90),
    delay: rand(0, 40),
    goRight,
    bobDuration: rand(30, 50) / 10,
  });
}
---

<div class="floating-boats" aria-hidden="true">
  {boats.map((boat, i) => (
    <div
      class={`floating-boat ${boat.goRight ? 'sail-right' : 'sail-left'}`}
      style={`top:${boat.top};width:${boat.size}px;height:${boat.size}px;opacity:${boat.opacity};animation-duration:${boat.duration}s;animation-delay:-${boat.delay}s;`}
    >
      <svg class="boat-bob" viewBox="0 0 120 90" fill="none" xmlns="http://www.w3.org/2000/svg"
        style={`animation-duration:${boat.bobDuration}s;`}
      >
        <!-- Hull -->
        <path d="M25 55 L30 72 L90 72 L95 55 Z" fill="#92400e" />
        <path d="M22 55 L98 55 L102 60 L18 60 Z" fill="#b45309" />
        <path d="M28 60 L92 60 L89 68 L31 68 Z" fill="#d97706" opacity="0.5" />
        <path d="M31 68 L89 68 L85 75 L35 75 Z" fill="#78350f" />
        <!-- Mast -->
        <line x1="60" y1="8" x2="60" y2="55" stroke="#92400e" stroke-width="2.5" stroke-linecap="round" />
        <!-- Yard + boom -->
        <line x1="62" y1="12" x2="82" y2="12" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" />
        <line x1="62" y1="52" x2="88" y2="52" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" />
        <!-- Main sail -->
        <path d="M62 12 L80 12 Q92 32 86 52 L62 52 Z" fill="white" opacity="0.95" />
        <!-- Secondary sail -->
        <line x1="58" y1="15" x2="40" y2="15" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" />
        <line x1="58" y1="50" x2="34" y2="50" stroke="#92400e" stroke-width="1.5" stroke-linecap="round" />
        <path d="M58 15 L42 15 Q30 33 35 50 L58 50 Z" fill="white" opacity="0.85" />
        <!-- Flag -->
        <path d="M60 8 L60 0 L74 4 L60 7 Z" fill="#f59e0b" />
        <!-- Bowsprit + jib -->
        <line x1="95" y1="55" x2="108" y2="49" stroke="#92400e" stroke-width="1.8" stroke-linecap="round" />
        <path d="M60 14 L104 52 L95 55 Z" fill="white" opacity="0.6" />
        <!-- Portholes -->
        <circle cx="45" cy="58" r="2" fill="#fcd34d" opacity="0.7" />
        <circle cx="55" cy="58" r="2" fill="#fcd34d" opacity="0.7" />
        <circle cx="65" cy="58" r="2" fill="#fcd34d" opacity="0.7" />
        <circle cx="75" cy="58" r="2" fill="#fcd34d" opacity="0.7" />
      </svg>
    </div>
  ))}
</div>

<style>
  .floating-boats {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 5; /* below suns (10), below header (50) */
    overflow: hidden;
  }

  .floating-boat {
    position: absolute;
    pointer-events: none;
    user-select: none;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  /* Sail left-to-right: start off-screen left, end off-screen right */
  .sail-right {
    animation-name: sail-lr;
  }

  /* Sail right-to-left: start off-screen right, end off-screen left (flipped) */
  .sail-left {
    animation-name: sail-rl;
    transform: scaleX(-1);
  }

  @keyframes sail-lr {
    0%   { left: -10%; }
    100% { left: 110%; }
  }

  @keyframes sail-rl {
    0%   { left: 110%; }
    100% { left: -10%; }
  }

  .boat-bob {
    display: block;
    width: 100%;
    height: 100%;
    animation: boat-bob-float ease-in-out infinite;
  }

  @keyframes boat-bob-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    30%      { transform: translateY(-2px) rotate(0.6deg); }
    70%      { transform: translateY(1px) rotate(-0.3deg); }
  }
</style>
