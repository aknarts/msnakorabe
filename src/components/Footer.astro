---
import { url } from '../utils';
const currentYear = new Date().getFullYear();
---

<footer class="bg-primary-800 text-primary-100 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- School info -->
      <div>
        <h3 class="text-white font-bold text-lg mb-3">MŠ Na Korábě</h3>
        <p class="text-sm leading-relaxed">
          Na Korábě 2/350<br />
          180 00 Praha 8 – Libeň<br />
          Tel: <a href="tel:+420283842809" class="hover:text-white">+420 283 842 809</a>
        </p>
      </div>

      <!-- Second location -->
      <div>
        <h3 class="text-white font-bold text-lg mb-3">MŠ Lindnerova</h3>
        <p class="text-sm leading-relaxed">
          Lindnerova 1/575<br />
          180 00 Praha 8 – Libeň<br />
          Tel: <a href="tel:+420284842026" class="hover:text-white">+420 284 842 026</a>
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="text-white font-bold text-lg mb-3">Rychlé odkazy</h3>
        <ul class="text-sm space-y-1.5">
          <li><a href={url('/pro-rodice')} class="hover:text-white transition-colors">Pro rodiče</a></li>
          <li><a href={url('/pro-rodice#dokumenty')} class="hover:text-white transition-colors">Dokumenty ke stažení</a></li>
          <li><a href={url('/kontakt')} class="hover:text-white transition-colors">Kontakt</a></li>
          <li><a href={url('/odkazy')} class="hover:text-white transition-colors">Užitečné odkazy</a></li>
          <li><a href="http://dlk.cuni.cz/course/view.php?id=98" class="hover:text-white transition-colors" target="_blank" rel="noopener">Moodle portál</a></li>
          <li><a href="http://msnakorabe.rajce.idnes.cz/" class="hover:text-white transition-colors" target="_blank" rel="noopener">Fotogalerie</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-primary-600 mt-8 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-primary-300">
      <p>&copy; {currentYear} Mateřská škola, Praha 8, Na Korábě 2 &middot; IČO: 70919747</p>
      <a href="https://www.praha8.cz" target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-white transition-colors">
        <span>Zřizovatel:</span>
        <img src={url('/images/praha8-logo.png')} alt="Městská část Praha 8" class="h-6" />
      </a>
    </div>
  </div>
</footer>
