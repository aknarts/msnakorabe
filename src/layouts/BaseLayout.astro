---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingSuns from '../components/FloatingSuns.astro';
import { url } from '../utils';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Mateřská škola Na Korábě, Praha 8 – Libeň. Rodinná školka se saunou, solnou jeskyní a oceňovanou jídelnou.' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Mateřská škola Na Korábě, Praha 8, Libeň, školka, kindergarten" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={url('/images/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/images/logo.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col relative">
    <FloatingSuns />
    <Header currentPath={currentPath} />
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
