---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { url } from '../utils';
---

<BaseLayout title="Program | MŠ Na Korábě" description="Aktivity a kroužky MŠ Na Korábě – sauna, solná jeskyně, plavání, angličtina, keramika, školka v přírodě a další.">
  <section class="bg-gradient-to-r from-accent-50 to-sky-50 py-10">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-primary-700">Program</h1>
      <p class="text-gray-600 mt-2">Aktivity a kroužky pro vaše děti</p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 py-10 space-y-16">
    <section>
      <h2 class="text-2xl font-bold text-primary-700 mb-3">Aktivity</h2>
      <p class="text-gray-700 leading-relaxed mb-10 max-w-prose">
        Během školního roku děti čeká pestrá nabídka aktivit, od pohybu a zdraví
        přes přírodu až po kulturu a tvořivost.
      </p>

      <!-- Featured pair: signature offerings with large images -->
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="relative rounded-2xl overflow-hidden group">
          <img src={url('/images/img5A.jpg')} alt="Děti v sauně" class="w-full h-64 md:h-72 object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-primary-900/80 via-primary-900/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h3 class="text-xl font-bold text-white mb-1">Sauna</h3>
            <p class="text-white/85 text-sm leading-relaxed">
              Pravidelné saunování v naší vlastní sauně posiluje imunitu dětí. Jsme členem Asociace saunujících školek ČR.
            </p>
          </div>
        </div>
        <div class="relative rounded-2xl overflow-hidden group">
          <img src={url('/images/img5F.jpg')} alt="Solná jeskyně" class="w-full h-64 md:h-72 object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-primary-900/80 via-primary-900/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h3 class="text-xl font-bold text-white mb-1">Solná jeskyně</h3>
            <p class="text-white/85 text-sm leading-relaxed">
              Vlastní solná jeskyně pro podporu zdraví a posílení imunity dětí.
            </p>
          </div>
        </div>
      </div>

      <!-- Secondary activities: asymmetric 2-col with image cards -->
      <div class="grid sm:grid-cols-5 gap-6 mb-10">
        <div class="sm:col-span-3">
          <FeatureCard
            image="/images/img5C.jpg"
            title="Škola v přírodě"
            description="Dvakrát ročně: na podzim do podhůří Šumavy, na jaře do Jizerských hor."
          />
        </div>
        <div class="sm:col-span-2">
          <FeatureCard
            image="/images/img5E.jpg"
            title="Interaktivní výuka"
            description="Interaktivní tabule, digitální mikroskopy a další pomůcky zapojují děti do objevování světa."
          />
        </div>
      </div>

      <!-- Compact activities: emoji-led inline items -->
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-4 mb-10">
        <div class="flex items-start gap-3 py-3">
          <span class="text-3xl shrink-0" aria-hidden="true">🎭</span>
          <div>
            <h3 class="font-bold text-primary-700">Divadlo</h3>
            <p class="text-gray-600 text-sm">Každý měsíc představení ve školce. Pravidelné návštěvy divadel v rámci Klubu malého diváka.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 py-3">
          <span class="text-3xl shrink-0" aria-hidden="true">🌿</span>
          <div>
            <h3 class="font-bold text-primary-700">Příroda a zahrada</h3>
            <p class="text-gray-600 text-sm">Vlastní záhonky, pěstitelské pokusy a environmentální výchova přímo na školní zahradě.</p>
          </div>
        </div>
      </div>

      <!-- Additional activities: compact list -->
      <div class="bg-gray-50 rounded-2xl p-6">
        <h3 class="font-bold text-primary-700 mb-3">Další aktivity</h3>
        <ul class="text-gray-700 text-sm space-y-2 list-disc list-inside columns-1 md:columns-2">
          <li>Projekt „Celé Česko čte dětem"</li>
          <li>Zubní prevence v rámci projektových dnů</li>
          <li>Tělesná výchova ve vlastních tělocvičnách</li>
          <li>Keramické dílny a tvořivé dílny pro rodiče s dětmi</li>
          <li>Prevence negativních vlivů a bezpečnostní průprava</li>
          <li>Projekt „Medvídkova nemocnice" (studenti LF UK)</li>
        </ul>
      </div>
    </section>

    <!-- Clubs -->
    <section>
      <h2 class="text-2xl font-bold text-primary-700 mb-3">Kroužky</h2>
      <p class="text-gray-700 leading-relaxed mb-8 max-w-prose">
        Nad rámec běžného programu nabízíme zájmové kroužky pro starší děti:
      </p>

      <!-- Photo-based clubs: 2-col pair -->
      <div class="grid sm:grid-cols-2 gap-6 mb-8">
        <FeatureCard
          image="/images/img52.jpg"
          title="Keramika"
          description="Tvořivá práce s hlínou rozvíjí jemnou motoriku a fantazii."
        />
        <FeatureCard
          image="/images/img51.jpg"
          title="Plavání"
          description="Plavecký výcvik v bazénu Hloubětín."
        />
      </div>

      <!-- Emoji-based clubs: compact chip grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
        <div class="flex items-center gap-3 bg-white rounded-xl border border-gray-200 px-4 py-3">
          <span class="text-2xl" aria-hidden="true">🇬🇧</span>
          <div>
            <p class="font-bold text-sm text-primary-700">Angličtina hrou</p>
            <p class="text-xs text-gray-500">Přirozeně, hravě a bez stresu</p>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl border border-gray-200 px-4 py-3">
          <span class="text-2xl" aria-hidden="true">🎵</span>
          <div>
            <p class="font-bold text-sm text-primary-700">Flétna</p>
            <p class="text-xs text-gray-500">Výuka hry na zobcovou flétnu</p>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl border border-gray-200 px-4 py-3">
          <span class="text-2xl" aria-hidden="true">📚</span>
          <div>
            <p class="font-bold text-sm text-primary-700">Příprava na školu</p>
            <p class="text-xs text-gray-500">Kroužek šikovného předškoláka</p>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl border border-gray-200 px-4 py-3">
          <span class="text-2xl" aria-hidden="true">🥋</span>
          <div>
            <p class="font-bold text-sm text-primary-700">Kung-fu</p>
            <p class="text-xs text-gray-500">Koordinace, disciplína a sebedůvěra</p>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white rounded-xl border border-gray-200 px-4 py-3">
          <span class="text-2xl" aria-hidden="true">🧘</span>
          <div>
            <p class="font-bold text-sm text-primary-700">Jóga pro děti</p>
            <p class="text-xs text-gray-500">Relaxace, rovnováha a radost z pohybu</p>
          </div>
        </div>
      </div>

      <div class="bg-accent-50 rounded-xl p-5 text-sm text-gray-700">
        <strong>Poznámka:</strong> Kroužky jsou koncipovány pro starší děti. U 3-4letých dětí
        záleží na individuálních schopnostech. Více informací v sekci
        <a href={url('/pro-rodice#faq')} class="text-primary-500 hover:underline">Často kladené otázky</a>.
      </div>
    </section>
  </div>
</BaseLayout>
