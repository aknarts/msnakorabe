---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { url } from '../utils';
---

<BaseLayout title="Program | MŠ Na Korábě" description="Aktivity a kroužky MŠ Na Korábě – sauna, solná jeskyně, plavání, angličtina, keramika, školka v přírodě a další.">
  <!-- Page header -->
  <section class="bg-gradient-to-r from-accent-50 to-sky-50 py-10">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-primary-700">Program</h1>
      <p class="text-gray-600 mt-2">Aktivity a kroužky pro vaše děti</p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 py-10 space-y-12">
    <!-- Activities -->
    <section>
      <h2 class="text-2xl font-bold text-primary-700 mb-6">Aktivity</h2>
      <p class="text-gray-700 leading-relaxed mb-8">
        Během školního roku děti čeká pestrá nabídka aktivit — od pohybu a zdraví 
        přes přírodu až po kulturu a tvořivost.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <FeatureCard
          image="/images/img5A.jpg"
          title="Sauna"
          description="Pravidelné saunování v naší vlastní sauně posiluje imunitu dětí. Jsme členem Asociace saunujících školek ČR."
        />
        <FeatureCard
          image="/images/img5F.jpg"
          title="Solná jeskyně"
          description="Vlastní solná jeskyně pro podporu zdraví a posílení imunity dětí."
        />
        <FeatureCard
          image="/images/img5C.jpg"
          title="Škola v přírodě"
          description="Dvakrát ročně — na podzim do podhůří Šumavy, na jaře do Jizerských hor."
        />
        <FeatureCard
          image="/images/img5E.jpg"
          title="Interaktivní výuka"
          description="Interaktivní tabule, digitální mikroskopy a další pomůcky zapojují děti do objevování světa."
        />
        <FeatureCard
          icon="🎭"
          title="Divadlo"
          description="Každý měsíc divadelní představení přímo ve školce. Pravidelné návštěvy divadel v rámci Klubu malého diváka."
        />
        <FeatureCard
          icon="🌿"
          title="Příroda a zahrada"
          description="Vlastní záhonky, pěstitelské pokusy a environmentální výchova přímo na školní zahradě."
        />
      </div>

      <!-- Additional activities list -->
      <div class="mt-8 bg-gray-50 rounded-2xl p-6">
        <h3 class="font-bold text-primary-700 mb-3">Další aktivity</h3>
        <ul class="text-gray-700 text-sm space-y-2 list-disc list-inside columns-1 md:columns-2">
          <li>Projekt „Celé Česko čte dětem"</li>
          <li>Zubní prevence v rámci projektových dnů</li>
          <li>Tělesná výchova ve vlastních tělocvičnách</li>
          <li>Keramické dílny a tvořivé dílny pro rodiče s dětmi</li>
          <li>Prevence negativních vlivů a bezpečnostní průprava</li>
          <li>Projekt „Medvídkova nemocnice" (studenti LF UK)</li>
        </ul>
      </div>
    </section>

    <!-- Clubs -->
    <section>
      <h2 class="text-2xl font-bold text-primary-700 mb-6">Kroužky</h2>
      <p class="text-gray-700 leading-relaxed mb-8">
        Nad rámec běžného programu nabízíme zájmové kroužky pro starší děti:
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <FeatureCard
          icon="🇬🇧"
          title="Angličtina hrou"
          description="První kontakt s angličtinou — přirozeně, hravě a bez stresu."
        />
        <FeatureCard
          image="/images/img52.jpg"
          title="Keramika"
          description="Tvořivá práce s hlínou rozvíjí jemnou motoriku a fantazii."
        />
        <FeatureCard
          image="/images/img51.jpg"
          title="Plavání"
          description="Plavecký výcvik v bazénu Hloubětín."
        />
        <FeatureCard
          icon="🎵"
          title="Flétna"
          description="Hudební kroužek s výukou hry na zobcovou flétnu."
        />
        <FeatureCard
          icon="📚"
          title="Příprava na školu"
          description="Kroužek šikovného předškoláka — příprava na vstup do základní školy."
        />
        <FeatureCard
          icon="🥋"
          title="Kung-fu"
          description="Koordinace, disciplína a sebedůvěra skrze bojové umění."
        />
        <FeatureCard
          icon="🧘"
          title="Jóga pro děti"
          description="Relaxace, rovnováha a radost z pohybu."
        />
      </div>

      <div class="mt-6 bg-accent-50 rounded-xl p-5 text-sm text-gray-700">
        <strong>Poznámka:</strong> Kroužky jsou koncipovány pro starší děti. U 3–4letých dětí 
        záleží na individuálních schopnostech. Více informací v sekci 
        <a href={url('/pro-rodice#faq')} class="text-primary-500 hover:underline">Často kladené otázky</a>.
      </div>
    </section>
  </div>
</BaseLayout>
