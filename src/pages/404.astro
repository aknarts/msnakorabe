---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils';
---

<BaseLayout title="Stránka nenalezena | MŠ Na Korábě">
  <div class="max-w-6xl mx-auto px-4 py-20 text-center">
    <div class="text-6xl mb-6">🚢</div>
    <h1 class="text-3xl font-bold text-primary-700 mb-4">Tato loďka zabloudila...</h1>
    <p class="text-gray-600 mb-8 max-w-md mx-auto">
      Stránka, kterou hledáte, neexistuje nebo byla přesunuta. 
      Vraťte se na hlavní palubu!
    </p>
    <a href={url('/')} class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
      Zpět na úvodní stránku
    </a>
  </div>
</BaseLayout>
