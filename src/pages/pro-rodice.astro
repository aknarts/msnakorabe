---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementCard from '../components/AnnouncementCard.astro';
import FaqItem from '../components/FaqItem.astro';
import { url } from '../utils';
import { getCollection, render } from 'astro:content';

const announcements = (await getCollection('announcements'))
  .filter(a => a.data.active)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const faqItems = (await getCollection('faq'))
  .filter(f => f.data.active)
  .sort((a, b) => a.data.order - b.data.order);

const allDocs = (await getCollection('documents'))
  .filter(d => d.data.active);

const docsByCategory = {
  enrollment: allDocs.filter(d => d.data.category === 'enrollment'),
  rules: allDocs.filter(d => d.data.category === 'rules'),
  'nature-school': allDocs.filter(d => d.data.category === 'nature-school'),
  gdpr: allDocs.filter(d => d.data.category === 'gdpr'),
};

const categoryLabels: Record<string, string> = {
  enrollment: 'Přijímací řízení 2026/2027',
  rules: 'Školní řád a formuláře',
  'nature-school': 'Školka v přírodě',
  gdpr: 'Ochrana osobních údajů',
};
---

<BaseLayout title="Pro rodiče | MŠ Na Korábě" description="Informace pro rodiče — dokumenty ke stažení, často kladené otázky, aktuality MŠ Na Korábě.">
  <!-- Page header -->
  <section class="bg-gradient-to-r from-accent-50 to-sky-50 py-10">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-primary-700">Pro rodiče</h1>
      <p class="text-gray-600 mt-2">Dokumenty, aktuality a odpovědi na vaše otázky</p>
    </div>
  </section>

  <!-- Quick nav -->
  <div class="max-w-6xl mx-auto px-4 py-6">
    <nav class="flex flex-wrap gap-2">
      <a href="#aktuality" class="text-sm bg-primary-100 text-primary-700 px-3 py-1.5 rounded-lg hover:bg-primary-200 transition-colors">Aktuality</a>
      <a href="#dokumenty" class="text-sm bg-primary-100 text-primary-700 px-3 py-1.5 rounded-lg hover:bg-primary-200 transition-colors">Dokumenty</a>
      <a href="#faq" class="text-sm bg-primary-100 text-primary-700 px-3 py-1.5 rounded-lg hover:bg-primary-200 transition-colors">Časté otázky</a>
      <a href={url('/odkazy')} class="text-sm bg-primary-100 text-primary-700 px-3 py-1.5 rounded-lg hover:bg-primary-200 transition-colors">Užitečné odkazy</a>
    </nav>
  </div>

  <div class="max-w-6xl mx-auto px-4 pb-10 space-y-12">
    <!-- Announcements -->
    <section id="aktuality">
      <h2 class="text-2xl font-bold text-primary-700 mb-6">Aktuality</h2>
      <div class="space-y-4">
        {await Promise.all(announcements.map(async (announcement) => {
          const { Content } = await render(announcement);
          return (
            <AnnouncementCard
              title={announcement.data.title}
              date={announcement.data.date}
              priority={announcement.data.priority}
            >
              <Content />
            </AnnouncementCard>
          );
        }))}
      </div>
      <div class="mt-4">
        <a href={url('/documents/akce-2025-2026.pdf')} class="text-primary-500 hover:underline text-sm" target="_blank">
          Plán akcí na školní rok 2025/2026 (PDF)
        </a>
      </div>
    </section>

    <!-- Documents -->
    <section id="dokumenty">
      <h2 class="text-2xl font-bold text-primary-700 mb-6">Dokumenty ke stažení</h2>
      {Object.entries(docsByCategory).map(([cat, docs]) => docs.length > 0 && (
        <div class="mb-8">
          <h3 class="font-bold text-primary-700 mb-3 text-lg">{categoryLabels[cat]}</h3>
          <div class="bg-white rounded-xl border border-gray-200 divide-y divide-gray-100">
            {docs.map(doc => (
              <a href={url(`/documents/${doc.data.filename}`)} class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors" target="_blank">
                <span class={`shrink-0 ${doc.data.filename.endsWith('.zip') ? 'text-blue-500' : 'text-red-500'}`}>
                  {doc.data.filename.endsWith('.zip') ? 'ZIP' : 'PDF'}
                </span>
                <span class="text-gray-700 text-sm">{doc.data.title}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2 class="text-2xl font-bold text-primary-700 mb-6">Často kladené otázky</h2>
      <div class="space-y-3">
        {await Promise.all(faqItems.map(async (item) => {
          const { Content } = await render(item);
          return (
            <FaqItem question={item.data.question}>
              <Content />
            </FaqItem>
          );
        }))}
      </div>
    </section>
  </div>
</BaseLayout>
