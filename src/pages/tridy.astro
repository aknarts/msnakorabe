---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const siteEntries = await getCollection('site');
const s = siteEntries[0].data;

const personnelEntries = await getCollection('personnel');
const management = personnelEntries.filter(p => p.data.section === 'management' && p.data.phone);
const classes = personnelEntries.filter(p => p.data.section === 'classes');
---

<BaseLayout title="Třídy | MŠ Na Korábě" description="Třídy a učitelky MŠ Na Korábě — Lvíčatka, Hrošíci, Opičky, Sluníčka, Berušky.">
  <!-- Page header -->
  <section class="bg-gradient-to-r from-primary-50 to-sky-50 py-10">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-primary-700">Třídy</h1>
      <p class="text-gray-600 mt-2">Naše třídy a pedagogický tým</p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 py-10">
    <!-- Virtual tour -->
    <div class="bg-primary-50 rounded-2xl p-6 mb-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h2 class="font-bold text-primary-700 text-lg">Virtuální prohlídka</h2>
        <p class="text-gray-600 text-sm">Prohlédněte si naše třídy online.</p>
      </div>
      <a href={s.virtual_tour_url} target="_blank" rel="noopener" class="shrink-0 bg-primary-600 hover:bg-primary-700 text-white font-semibold px-5 py-2.5 rounded-xl transition-colors">
        Otevřít prohlídku
      </a>
    </div>

    <!-- Management -->
    <div class="mb-10">
      <h2 class="text-2xl font-bold text-primary-700 mb-4">Vedení školy</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {management.map(m => (
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="font-bold text-primary-700">{m.data.name}</p>
            <p class="text-sm text-gray-600">{m.data.title}</p>
            <p class="text-sm text-gray-500 mt-1">
              <a href={`tel:${m.data.phone?.replace(/\s/g, '')}`} class="hover:text-primary-500">{m.data.phone}</a> &middot;
              <a href={`mailto:${m.data.email}`} class="hover:text-primary-500">{m.data.email}</a>
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Classes grid -->
    <h2 class="text-2xl font-bold text-primary-700 mb-6">Ve třídách se o děti starají</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {classes.map(cls => (
        <div class="bg-white rounded-2xl shadow-md p-6 hover:shadow-lg transition-shadow">
          <div class="text-4xl mb-3">{cls.data.emoji}</div>
          <h3 class="font-bold text-xl text-primary-700 mb-3">Třída {cls.data.class_name}</h3>
          <ul class="space-y-1.5">
            {cls.data.teachers?.map(teacher => (
              <li class="text-sm text-gray-700">
                <span class="font-medium">{teacher.name}</span>
                {teacher.role && (
                  <span class="text-gray-500"> — {teacher.role}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
