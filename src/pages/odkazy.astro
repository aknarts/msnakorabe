---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils';
import { getCollection } from 'astro:content';

const allLinks = (await getCollection('links'))
  .filter(l => l.data.active)
  .sort((a, b) => a.data.order - b.data.order);

const budgetDocs = (await getCollection('documents'))
  .filter(d => d.data.active && d.data.category === 'budget');

const linksByCategory = {
  portal: allLinks.filter(l => l.data.category === 'portal'),
  municipality: allLinks.filter(l => l.data.category === 'municipality'),
  budget: allLinks.filter(l => l.data.category === 'budget'),
  regulation: allLinks.filter(l => l.data.category === 'regulation'),
};

const categoryLabels: Record<string, string> = {
  portal: 'Portály',
  municipality: 'Městská část',
  budget: 'Rozpočtové dokumenty',
  regulation: 'Předpisy',
};
---

<BaseLayout title="Odkazy | MŠ Na Korábě" description="Užitečné odkazy — Moodle, fotogalerie, rozpočty, předpisy.">
  <section class="bg-gradient-to-r from-accent-50 to-sky-50 py-10">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-primary-700">Užitečné odkazy</h1>
      <p class="text-gray-600 mt-2">Portály, rozpočty a předpisy</p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 py-10 space-y-10">
    {Object.entries(linksByCategory).map(([cat, links]) => links.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold text-primary-700 mb-4">{categoryLabels[cat]}</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {links.map(link => (
            <a href={link.data.url} target="_blank" rel="noopener" class="bg-white rounded-xl border border-gray-200 p-4 hover:bg-gray-50 transition-colors">
              <p class="font-bold text-primary-700">{link.data.title}</p>
              {link.data.description && (
                <p class="text-sm text-gray-500">{link.data.description}</p>
              )}
            </a>
          ))}
        </div>
      </section>
    ))}

    {budgetDocs.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold text-primary-700 mb-4">Rozpočtové dokumenty ke stažení</h2>
        <div class="bg-white rounded-xl border border-gray-200 divide-y divide-gray-100">
          {budgetDocs.map(doc => (
            <a href={url(`/documents/${doc.data.filename}`)} class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors" target="_blank">
              <span class="text-red-500 shrink-0">PDF</span>
              <span class="text-gray-700 text-sm">{doc.data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
