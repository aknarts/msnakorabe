---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kontakt | MŠ Na Korábě" description="Kontaktní informace MŠ Na Korábě a MŠ Lindnerova, Praha 8 – Libeň.">
  <!-- Page header -->
  <section class="bg-primary-50 py-10">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-primary-700">Kontakt</h1>
      <p class="text-gray-600 mt-2">Kontaktní informace obou pracovišť</p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 py-10 space-y-10">
    <!-- Operating hours -->
    <div class="bg-accent-50 rounded-2xl p-6">
      <h2 class="font-bold text-primary-700 text-lg mb-2">Provozní doba</h2>
      <p class="text-gray-700">
        <strong>6:30 / 7:00 – 17:00</strong> &middot; 
        Děti splňující povinnou předškolní docházku přichází od 7:00 do 9:00. 
        Doporučujeme příchod do 8:30.
      </p>
    </div>

    <!-- Locations -->
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Na Korábě -->
      <div class="bg-white rounded-2xl shadow-md p-6">
        <h2 class="font-bold text-xl text-primary-700 mb-4">MŠ Na Korábě</h2>
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-gray-500 font-medium">Adresa</dt>
            <dd class="text-gray-700">Na Korábě 2/350, 180 00 Praha 8 – Libeň</dd>
          </div>
          <div>
            <dt class="text-gray-500 font-medium">Telefon</dt>
            <dd class="text-gray-700"><a href="tel:+420283842809" class="text-primary-500 hover:underline">+420 283 842 809</a></dd>
          </div>
          <div>
            <dt class="text-gray-500 font-medium">Omluvy dětí</dt>
            <dd class="text-gray-700"><a href="mailto:skolkanakorabeomluvydeti@seznam.cz" class="text-primary-500 hover:underline">skolkanakorabeomluvydeti@seznam.cz</a></dd>
          </div>
          <div>
            <dt class="text-gray-500 font-medium">Jídelna</dt>
            <dd class="text-gray-700"><a href="tel:+420283843286" class="text-primary-500 hover:underline">+420 283 843 286</a></dd>
          </div>
        </dl>
      </div>

      <!-- Lindnerova -->
      <div class="bg-white rounded-2xl shadow-md p-6">
        <h2 class="font-bold text-xl text-primary-700 mb-4">MŠ Lindnerova</h2>
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-gray-500 font-medium">Adresa</dt>
            <dd class="text-gray-700">Lindnerova 1/575, 180 00 Praha 8 – Libeň</dd>
          </div>
          <div>
            <dt class="text-gray-500 font-medium">Telefon</dt>
            <dd class="text-gray-700"><a href="tel:+420284842026" class="text-primary-500 hover:underline">+420 284 842 026</a></dd>
          </div>
          <div>
            <dt class="text-gray-500 font-medium">Email</dt>
            <dd class="text-gray-700"><a href="mailto:mslindnerova@seznam.cz" class="text-primary-500 hover:underline">mslindnerova@seznam.cz</a></dd>
          </div>
          <div>
            <dt class="text-gray-500 font-medium">Jídelna</dt>
            <dd class="text-gray-700"><a href="tel:+420284840029" class="text-primary-500 hover:underline">+420 284 840 029</a></dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Management -->
    <section>
      <h2 class="text-2xl font-bold text-primary-700 mb-4">Vedení školy</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="bg-gray-50 rounded-xl p-5">
          <p class="font-bold text-primary-700">Mgr. Hana Francová</p>
          <p class="text-sm text-gray-600 mb-2">Ředitelka školy</p>
          <p class="text-sm text-gray-700">
            <a href="tel:+420728125539" class="text-primary-500 hover:underline">+420 728 125 539</a><br />
            <a href="mailto:reditelka@msnakorabe.cz" class="text-primary-500 hover:underline">reditelka@msnakorabe.cz</a>
          </p>
          <p class="text-xs text-gray-500 mt-2">Úřední hodiny po telefonické domluvě</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-5">
          <p class="font-bold text-primary-700">Jana Paříková</p>
          <p class="text-sm text-gray-600 mb-2">Zástupkyně ředitelky</p>
          <p class="text-sm text-gray-700">
            <a href="tel:+420739643387" class="text-primary-500 hover:underline">+420 739 643 387</a><br />
            <a href="mailto:zastupkyne@msnakorabe.cz" class="text-primary-500 hover:underline">zastupkyne@msnakorabe.cz</a>
          </p>
        </div>
        <div class="bg-gray-50 rounded-xl p-5">
          <p class="font-bold text-primary-700">Mgr. Lucie Francová</p>
          <p class="text-sm text-gray-600 mb-2">Vedoucí školní jídelny</p>
          <p class="text-sm text-gray-700">
            <a href="mailto:hospodarka@msnakorabe.cz" class="text-primary-500 hover:underline">hospodarka@msnakorabe.cz</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Official info -->
    <section>
      <h2 class="text-2xl font-bold text-primary-700 mb-4">Úřední údaje</h2>
      <div class="bg-gray-50 rounded-xl p-5 text-sm text-gray-700 space-y-1">
        <p><strong>IČO:</strong> 70919747</p>
        <p><strong>Datová schránka:</strong> z7ikxu2</p>
        <p><strong>Zřizovatel:</strong> <a href="https://www.praha8.cz" class="text-primary-500 hover:underline" target="_blank" rel="noopener">Městská část Praha 8</a></p>
      </div>
    </section>

    <!-- Map -->
    <section>
      <h2 class="text-2xl font-bold text-primary-700 mb-4">Kde nás najdete</h2>
      <div class="rounded-2xl overflow-hidden shadow-md">
        <iframe
          src="https://frame.mapy.cz/s/cukahubofo"
          width="100%"
          height="400"
          frameborder="0"
          class="w-full"
          loading="lazy"
          title="Mapa - MŠ Na Korábě"
        ></iframe>
      </div>
      <p class="text-xs text-gray-500 mt-2 text-center">
        Obě pracoviště se nachází v Praze 8 – Libni, v docházkové vzdálenosti od sebe.
      </p>
    </section>
  </div>
</BaseLayout>
