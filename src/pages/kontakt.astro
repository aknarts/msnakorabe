---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const siteEntries = await getCollection('site');
const s = siteEntries[0].data;

const personnelEntries = await getCollection('personnel');
const management = personnelEntries.filter(p => p.data.section === 'management');
---

<BaseLayout title="Kontakt | MŠ Na Korábě" description="Kontaktní informace MŠ Na Korábě a MŠ Lindnerova, Praha 8 – Libeň.">
  <!-- Page header -->
  <section class="bg-gradient-to-r from-accent-50 to-sky-50 py-10">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-primary-700">Kontakt</h1>
      <p class="text-gray-600 mt-2">Kontaktní informace obou pracovišť</p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 py-10 space-y-10">
    <!-- Operating hours -->
    <div class="bg-accent-50 rounded-2xl p-6">
      <h2 class="font-bold text-primary-700 text-lg mb-2">Provozní doba</h2>
      <p class="text-gray-700">
        <strong>{s.hours}</strong> &middot; 
        {s.hours_note}
      </p>
    </div>

    <!-- Locations -->
    <div class="grid md:grid-cols-2 gap-6">
      {s.buildings.map(b => (
        <div class="bg-white rounded-2xl shadow-md p-6">
          <h2 class="font-bold text-xl text-primary-700 mb-4">{b.name}</h2>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-gray-500 font-medium">Adresa</dt>
              <dd class="text-gray-700">{b.address}</dd>
            </div>
            <div>
              <dt class="text-gray-500 font-medium">Telefon</dt>
              <dd class="text-gray-700"><a href={`tel:${b.phone.replace(/\s/g, '')}`} class="text-primary-500 hover:underline">{b.phone}</a></dd>
            </div>
            {b.email && (
              <div>
                <dt class="text-gray-500 font-medium">{b.email.includes('omluvy') ? 'Omluvy dětí' : 'Email'}</dt>
                <dd class="text-gray-700"><a href={`mailto:${b.email}`} class="text-primary-500 hover:underline">{b.email}</a></dd>
              </div>
            )}
            <div>
              <dt class="text-gray-500 font-medium">Jídelna</dt>
              <dd class="text-gray-700"><a href={`tel:${b.cafeteria_phone.replace(/\s/g, '')}`} class="text-primary-500 hover:underline">{b.cafeteria_phone}</a></dd>
            </div>
          </dl>
        </div>
      ))}
    </div>

    <!-- Management -->
    <section>
      <h2 class="text-2xl font-bold text-primary-700 mb-4">Vedení školy</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {management.map(m => (
          <div class="bg-gray-50 rounded-xl p-5">
            <p class="font-bold text-primary-700">{m.data.name}</p>
            <p class="text-sm text-gray-600 mb-2">{m.data.title}</p>
            <p class="text-sm text-gray-700">
              {m.data.phone && (
                <><a href={`tel:${m.data.phone.replace(/\s/g, '')}`} class="text-primary-500 hover:underline">{m.data.phone}</a><br /></>
              )}
              {m.data.email && (
                <a href={`mailto:${m.data.email}`} class="text-primary-500 hover:underline">{m.data.email}</a>
              )}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Official info -->
    <section>
      <h2 class="text-2xl font-bold text-primary-700 mb-4">Úřední údaje</h2>
      <div class="bg-gray-50 rounded-xl p-5 text-sm text-gray-700 space-y-1">
        <p><strong>IČO:</strong> {s.ico}</p>
        <p><strong>Datová schránka:</strong> {s.data_box}</p>
        <p><strong>Zřizovatel:</strong> <a href={s.founder.url} class="text-primary-500 hover:underline" target="_blank" rel="noopener">{s.founder.name}</a></p>
      </div>
    </section>

    <!-- Maps -->
    <section>
      <h2 class="text-2xl font-bold text-primary-700 mb-4">Kde nás najdete</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Na Korábě map -->
        <div>
          <h3 class="font-semibold text-primary-700 mb-2">MŠ Na Korábě</h3>
          <div class="rounded-2xl overflow-hidden shadow-md">
            <iframe
              src="https://www.openstreetmap.org/export/embed.html?bbox=14.4650%2C50.1119%2C14.4710%2C50.1159&layer=mapnik&marker=50.113894%2C14.468020"
              width="100%"
              height="300"
              class="w-full"
              loading="lazy"
              title="Mapa - MŠ Na Korábě"
              style="border: 0;"
            ></iframe>
          </div>
          <p class="text-sm text-gray-500 mt-2">
            Na Korábě 2/350, Praha 8
            <a href="https://mapy.com/cs/zakladni?q=Na%20Kor%C3%A1b%C4%9B%20350%2F2%20Praha%208&source=firm&id=406939&ds=2&x=14.4683309&y=50.1140574&z=19" target="_blank" rel="noopener" class="text-primary-500 hover:underline ml-1">Mapy.cz &rarr;</a>
          </p>
        </div>
        <!-- Lindnerova map -->
        <div>
          <h3 class="font-semibold text-primary-700 mb-2">MŠ Lindnerova</h3>
          <div class="rounded-2xl overflow-hidden shadow-md">
            <iframe
              src="https://www.openstreetmap.org/export/embed.html?bbox=14.4700%2C50.1098%2C14.4760%2C50.1138&layer=mapnik&marker=50.111840%2C14.473007"
              width="100%"
              height="300"
              class="w-full"
              loading="lazy"
              title="Mapa - MŠ Lindnerova"
              style="border: 0;"
            ></iframe>
          </div>
          <p class="text-sm text-gray-500 mt-2">
            Lindnerova 1/575, Praha 8
            <a href="https://mapy.com/cs/zakladni?q=Na%20Kor%C3%A1b%C4%9B%20350%2F2%20Praha%208&source=firm&id=2187455&ds=2&x=14.4741969&y=50.1121430&z=19" target="_blank" rel="noopener" class="text-primary-500 hover:underline ml-1">Mapy.cz &rarr;</a>
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
