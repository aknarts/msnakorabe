---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementCard from '../components/AnnouncementCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { getCollection, render } from 'astro:content';

const announcements = (await getCollection('announcements'))
  .filter(a => a.data.active)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="MŠ Na Korábě | Mateřská škola Praha 8">
  <!-- Hero -->
  <section class="relative bg-primary-700 text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-800 via-primary-700 to-primary-500 opacity-90"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-16 md:py-24">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 leading-tight">
            MŠ Na Korábě
          </h1>
          <p class="text-xl text-primary-200 italic mb-6">
            „Jak si loďku postavíme, tak si na ní zajezdíme."
          </p>
          <p class="text-primary-100 mb-8 leading-relaxed">
            Rodinná mateřská škola v Praze 8 – Libni. Stavíme loďku z pevných, ale pružných základů, 
            která bezpečně doveze vaše děti k jejich cíli.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/pro-rodice#dokumenty" class="inline-block bg-accent-400 hover:bg-accent-500 text-primary-800 font-semibold px-6 py-3 rounded-xl transition-colors">
              Zápis 2026/2027
            </a>
            <a href="/kontakt" class="inline-block bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-xl transition-colors border border-white/20">
              Kontakt
            </a>
          </div>
        </div>
        <div class="hidden md:block">
          <img src="/images/img4D.jpg" alt="Budova MŠ Na Korábě" class="rounded-2xl shadow-2xl" />
        </div>
      </div>
    </div>
  </section>

  <!-- Announcements -->
  {announcements.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-bold text-primary-700 mb-6">Aktuality</h2>
      <div class="space-y-4">
        {await Promise.all(announcements.map(async (announcement) => {
          const { Content } = await render(announcement);
          return (
            <AnnouncementCard
              title={announcement.data.title}
              date={announcement.data.date}
              priority={announcement.data.priority}
            >
              <Content />
            </AnnouncementCard>
          );
        }))}
      </div>
    </section>
  )}

  <!-- Highlights -->
  <section class="bg-gray-50 py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary-700 mb-8 text-center">Co nabízíme</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <FeatureCard
          icon="🧖"
          title="Vlastní sauna"
          description="Jsme členem Asociace saunujících školek ČR. Pravidelné saunování posiluje imunitu dětí."
        />
        <FeatureCard
          icon="🧂"
          title="Solná jeskyně"
          description="Vlastní solná jeskyně pro povzbuzení imunitního systému a podporu zdraví dětí."
        />
        <FeatureCard
          icon="🌳"
          title="Parková zahrada"
          description="Prostorná zahrada s moderními herními prvky a záhonky, o které se děti samy starají."
        />
        <FeatureCard
          icon="🏆"
          title="Oceňovaná jídelna"
          description="1. místo v soutěži 'Školní jídelna chutně a zdravě', 4x finále celostátní soutěže."
        />
      </div>
      <div class="text-center mt-8">
        <a href="/program" class="text-primary-500 hover:text-primary-700 font-medium transition-colors">
          Zobrazit celý program &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Quick contact -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="bg-primary-50 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-primary-700 mb-1">Máte dotaz?</h2>
        <p class="text-gray-600">
          Ředitelka školy: Mgr. Hana Francová &middot; 
          <a href="tel:+420728125539" class="text-primary-500 hover:underline">+420 728 125 539</a> &middot;
          <a href="mailto:reditelka@msnakorabe.cz" class="text-primary-500 hover:underline">reditelka@msnakorabe.cz</a>
        </p>
      </div>
      <a href="/kontakt" class="shrink-0 bg-primary-600 hover:bg-primary-700 text-white font-semibold px-5 py-2.5 rounded-xl transition-colors">
        Všechny kontakty
      </a>
    </div>
  </section>
</BaseLayout>
