---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementCard from '../components/AnnouncementCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { url } from '../utils';
import { getCollection, render } from 'astro:content';

const siteEntries = await getCollection('site');
const s = siteEntries[0].data;

const personnelEntries = await getCollection('personnel');
const director = personnelEntries.find(p => p.id === 'director')?.data;

const allAnnouncements = (await getCollection('announcements'))
  .filter(a => a.data.active)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const pinned = allAnnouncements.filter(a => a.data.pinned);
const recent = allAnnouncements.filter(a => !a.data.pinned).slice(0, 3);
const announcements = [...pinned, ...recent];
const hasMore = allAnnouncements.length > announcements.length;

const rand = (min: number, max: number) => Math.floor(Math.random() * (max - min + 1)) + min;
const pick = <T,>(arr: T[]): T => arr[Math.floor(Math.random() * arr.length)];

const cloudTints = [
  'rgba(255,255,255',    // white
  'rgba(224,242,254',    // sky-100
  'rgba(186,230,253',    // sky-200
  'rgba(254,243,199',    // warm yellow
  'rgba(237,233,254',    // soft lavender
];

const heroCount = rand(4, 6);
const heroPlaced: { top: number; left: number }[] = [];
const MIN_DIST_TOP = 20;
const MIN_DIST_LEFT = 25;

function tooCloseToExisting(top: number, left: number): boolean {
  return heroPlaced.some(p => Math.abs(p.top - top) < MIN_DIST_TOP && Math.abs(p.left - left) < MIN_DIST_LEFT);
}

interface HeroCloud {
  top: string; left: string; scale: string; blur: number; opacity: string; color: string;
}
const heroClouds: HeroCloud[] = [];

for (let i = 0; i < heroCount; i++) {
  let top = rand(0, 80);
  let left = rand(-10, 75);
  let attempts = 0;
  while (tooCloseToExisting(top, left) && attempts < 20) {
    top = rand(0, 80);
    left = rand(-10, 75);
    attempts++;
  }
  heroPlaced.push({ top, left });
  heroClouds.push({
    top: `${top}%`,
    left: `${left}%`,
    scale: (rand(6, 18) / 10).toFixed(1),
    blur: rand(3, 10),
    opacity: (rand(8, 18) / 100).toFixed(2),
    color: `${pick(cloudTints)},1)`,
  });
}
---

<BaseLayout title="MŠ Na Korábě | Mateřská škola Praha 8">
  <!-- Hero -->
  <section class="relative z-[15] bg-gradient-to-br from-primary-700 via-primary-600 to-sky-400 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 left-10 w-32 h-32 bg-accent-400 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-20 w-48 h-48 bg-sky-300 rounded-full blur-3xl"></div>
    </div>
    <!-- Peeking suns — z-20 so they layer above the hero content -->
    <img src={url('/images/sun1a.gif')} alt="" class="absolute -top-4 left-8 md:left-16 w-28 md:w-36 opacity-70 pointer-events-none z-20" aria-hidden="true" />
    <img src={url('/images/sun2a.gif')} alt="" class="absolute -top-2 right-6 md:right-20 w-24 md:w-32 opacity-60 pointer-events-none z-20" aria-hidden="true" />
    <img src={url('/images/sun1a.gif')} alt="" class="absolute top-1/3 -left-4 md:-left-6 w-28 md:w-36 opacity-55 pointer-events-none z-20" aria-hidden="true" />
    <img src={url('/images/sun2a.gif')} alt="" class="absolute bottom-8 -right-4 md:-right-6 w-32 md:w-40 opacity-50 pointer-events-none hidden sm:block z-20" aria-hidden="true" />
    <!-- Hero clouds -->
    {heroClouds.map(c => (
      <div
        class="hero-cloud absolute pointer-events-none"
        style={`top:${c.top};left:${c.left};transform:scale(${c.scale});filter:blur(${c.blur}px);opacity:${c.opacity};--cloud-color:${c.color}`}
        aria-hidden="true"
      />
    ))}
    <div class="relative max-w-6xl mx-auto px-4 pt-8 pb-12 md:pt-12 md:pb-16 z-10">
      <div class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 leading-tight">
            {s.hero_heading ?? s.short_name}
          </h1>
          {s.hero_body && s.hero_body[0] && (
            <p class="text-white/85 mb-4 leading-relaxed">
              {s.hero_body[0]}
            </p>
          )}
          <p class="text-sky-200 italic mb-6">
            „{s.motto}"
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={url('/pro-rodice#dokumenty')} class="inline-block bg-accent-400 hover:bg-accent-500 text-primary-800 font-semibold px-6 py-3 rounded-xl transition-colors shadow-lg">
              Zápis 2026/2027
            </a>
            <a href={url('/kontakt')} class="inline-block bg-white/15 hover:bg-white/25 text-white font-semibold px-6 py-3 rounded-xl transition-colors border border-white/25 backdrop-blur-sm">
              Kontakt
            </a>
          </div>
        </div>
        <div class="hidden md:flex items-center justify-center">
          <!-- Wavy clip path + white ring border for the hero image -->
          <svg class="absolute w-0 h-0" aria-hidden="true">
            <defs>
              <clipPath id="wavy-frame" clipPathUnits="objectBoundingBox">
                <path d="
                  M 0.08,0.03
                  Q 0.17,0.015 0.28,0.04  Q 0.43,0.015 0.58,0.035  Q 0.72,0.02 0.92,0.03
                  C 0.95,0.03 0.97,0.05 0.97,0.08
                  Q 0.985,0.19 0.96,0.33  Q 0.98,0.52 0.965,0.68  Q 0.985,0.82 0.97,0.92
                  C 0.97,0.95 0.95,0.97 0.92,0.97
                  Q 0.78,0.985 0.62,0.96  Q 0.47,0.98 0.32,0.965  Q 0.18,0.985 0.08,0.97
                  C 0.05,0.97 0.03,0.95 0.03,0.92
                  Q 0.015,0.79 0.04,0.62  Q 0.02,0.47 0.035,0.32  Q 0.015,0.17 0.03,0.08
                  C 0.03,0.05 0.05,0.03 0.08,0.03
                  Z" />
              </clipPath>
            </defs>
          </svg>
          <div class="hero-wavy-frame">
            <img src={url('/images/MS-Na-Korabe-a.jpg')} alt="Koráb na moři" class="hero-wavy-img max-h-80 lg:max-h-96 w-auto object-contain block" />
          </div>
      </div>
    </div>
    <!-- Distant islands with palm trees -->
    <!-- Left island: small, one palm tree -->
    <div class="absolute bottom-3 -left-4 pointer-events-none opacity-50 z-[5] hidden lg:block" aria-hidden="true">
      <div class="relative w-32 h-24">
        <img src={url('/images/palm-tree.svg')} alt="" class="absolute bottom-4 left-8 w-14 h-14" />
        <svg class="absolute bottom-0 left-0 w-full" viewBox="0 0 200 50" fill="none">
          <ellipse cx="100" cy="40" rx="95" ry="10" fill="#f5d08a" opacity="0.7" />
          <path d="M10 40 Q40 15 100 22 Q155 10 190 40 Z" fill="#22c55e" opacity="0.8" />
          <path d="M25 40 Q60 22 110 28 Q160 18 180 40 Z" fill="#4ade80" opacity="0.6" />
        </svg>
      </div>
    </div>
    <!-- Right island: larger, two palm trees -->
    <div class="absolute bottom-2 -right-6 pointer-events-none opacity-55 z-[5] hidden lg:block" aria-hidden="true">
      <div class="relative w-48 h-28">
        <img src={url('/images/palm-tree.svg')} alt="" class="absolute bottom-5 left-10 w-16 h-16" />
        <img src={url('/images/palm-tree.svg')} alt="" class="absolute bottom-4 right-10 w-12 h-12" style="transform: scaleX(-1);" />
        <svg class="absolute bottom-0 left-0 w-full" viewBox="0 0 300 55" fill="none">
          <ellipse cx="150" cy="44" rx="140" ry="11" fill="#f5d08a" opacity="0.7" />
          <path d="M10 44 Q45 10 120 20 Q175 5 230 18 Q270 8 290 44 Z" fill="#22c55e" opacity="0.8" />
          <path d="M25 44 Q65 18 130 25 Q185 12 240 22 Q275 15 285 44 Z" fill="#4ade80" opacity="0.6" />
          <path d="M40 44 Q80 25 140 30 Q195 22 235 28 Q265 22 278 44 Z" fill="#86efac" opacity="0.4" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Illustrated ship scene — serves as hero-to-content divider -->
  <HeroIllustration />

  <!-- Welcome intro -->
  {s.hero_body && s.hero_body.length > 1 && (
    <section class="max-w-4xl mx-auto px-4 py-10">
      <div class="space-y-4 text-gray-700 leading-relaxed text-lg">
        {s.hero_body.slice(1).map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>
  )}

  <!-- Announcements -->
  {announcements.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-bold text-primary-700 mb-6">Aktuality</h2>
      <div class="space-y-4">
        {await Promise.all(announcements.map(async (announcement) => {
          const { Content } = await render(announcement);
          return (
            <AnnouncementCard
              title={announcement.data.title}
              date={announcement.data.date}
              priority={announcement.data.priority}
              pinned={announcement.data.pinned}
            >
              <Content />
            </AnnouncementCard>
          );
        }))}
      </div>
      {hasMore && (
        <div class="text-center mt-6">
          <a href={url('/pro-rodice#aktuality')} class="text-primary-500 hover:text-primary-700 font-medium transition-colors">
            Zobrazit všechny aktuality &rarr;
          </a>
        </div>
      )}
    </section>
  )}

  <!-- Highlights -->
  <section class="bg-accent-50/50 py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary-700 mb-8 text-center">Co nabízíme</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <FeatureCard
          image="/images/img5A.jpg"
          title="Vlastní sauna"
          description="Jsme členem Asociace saunujících školek ČR. Pravidelné saunování posiluje imunitu dětí."
        />
        <FeatureCard
          image="/images/img5F.jpg"
          title="Solná jeskyně"
          description="Vlastní solná jeskyně pro posílení imunity a podporu zdraví dětí."
        />
        <FeatureCard
          image="/images/img54.jpg"
          title="Školní zahrady"
          description="Obě pracoviště mají zahrady s herními prvky. Na Korábě navíc prostorná zahrada parkového typu se záhonky."
        />
        <FeatureCard
          image="/images/img56.jpg"
          title="Oceňovaná jídelna"
          description={`${s.kitchen_awards[0]}. ${s.kitchen_awards[1]}.`}
        />
      </div>
      <div class="text-center mt-8">
        <a href={url('/program')} class="text-primary-500 hover:text-primary-700 font-medium transition-colors">
          Zobrazit celý program &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Quick contact -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="bg-primary-50 rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-primary-700 mb-1">Máte dotaz?</h2>
        {director && (
          <p class="text-gray-600">
            {director.title}: {director.name} &middot;
            <a href={`tel:${director.phone?.replace(/\s/g, '')}`} class="text-primary-500 hover:underline">{director.phone}</a> &middot;
            <a href={`mailto:${director.email}`} class="text-primary-500 hover:underline">{director.email}</a>
          </p>
        )}
      </div>
      <a href={url('/kontakt')} class="shrink-0 bg-primary-600 hover:bg-primary-700 text-white font-semibold px-5 py-2.5 rounded-xl transition-colors">
        Všechny kontakty
      </a>
    </div>
  </section>
</BaseLayout>
